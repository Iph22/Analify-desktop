{
  "name": "analify-desktop",
  "productName": "Analify",
  "version": "0.2.0",
  "description": "Analify for Windows and Mac (beta): privacy-first software analytics in its own window.",
  "homepage": "https://analify.dev",
  "author": "Analify",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "dev.analify.desktop",
    "productName": "Analify",
    "copyright": "Copyright \u00a9 2026 Analify",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "assets/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Analify-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Analify",
      "runAfterFinish": true,
      "license": "LICENSE",
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business",
      "identity": null,
      "artifactName": "Analify-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "Analify",
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 140,
          "y": 190,
          "type": "file"
        },
        {
          "x": 400,
          "y": 190,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "afterPack": "./scripts/adhoc-sign.js",
    "publish": [
      {
        "provider": "github",
        "owner": "Iph22",
        "repo": "Analify-desktop",
        "releaseType": "release"
      }
    ],
    "protocols": [
      {
        "name": "Analify",
        "schemes": [
          "analify"
        ]
      }
    ]
  },
  "allowScripts": {
    "electron@33.2.1": true
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  }
}
